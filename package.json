{
  "name": "rysh-cli-app",
  "version": "0.2.0",
  "private": true,
  "description": "Rysh Desktop — Agentic terminal multiplexer with embedded web panes",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "make:mac": "electron-builder --mac",
    "make:linux": "electron-builder --linux",
    "icons": "./scripts/gen-icons.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^41.10.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "allowScripts": {
    "electron@41.10.1": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
